COMPOSE_PROJECT_NAME=tinyimx-m21
TINYIMX_RUNTIME_IMAGE=tinyimx/runtime:m21
TINYIMX_DEPLOYMENT_ENV=prod

TINYIMX_MYSQL_DATABASE=tinyimx
TINYIMX_MYSQL_USER=tinyimx
TINYIMX_MYSQL_PASSWORD=CHANGE_ME_MYSQL_APP_PASSWORD
TINYIMX_MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

TINYIMX_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

TINYIMX_MCP_TOKEN=CHANGE_ME_MCP_BEARER_TOKEN
TINYIMX_MCP_STATIC_USER_ID=1

TINYIMX_AI_API_KEY=
TINYIMX_AI_ENDPOINT=http://host.docker.internal:11434/v1/chat/completions
TINYIMX_AI_MODEL=qwen3:8b

TINYIMX_ROCKETMQ_TOPIC=tinyimx-message-events

TINYIMX_GATEWAY_PLAIN_PORT=9000
TINYIMX_GATEWAY_TLS_PORT=9443
TINYIMX_NGINX_HEALTH_PORT=18081
TINYIMX_MCP_HOST_PORT=18080
TINYIMX_PROMETHEUS_HOST_PORT=19090
TINYIMX_COLLECTOR_HEALTH_PORT=13133

# Optional desktop file/group-history ingress. For another machine, explicitly
# select the server's trusted private interface instead of exposing all interfaces.
TINYIMX_DESKTOP_BIND_ADDRESS=127.0.0.1
TINYIMX_DESKTOP_FILE_PORT=18082
